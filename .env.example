# Copy to .env and fill in. See README.md for where each value comes from.

# Public address of the site, without a trailing slash. The Discord OAuth2 redirect
# must be set to <PUBLIC_URL>/auth/callback in the Discord developer portal.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Long random string used to sign login cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Discord application (Developer Portal → your app → OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The server people must be a member of (right-click the server → Copy Server ID).
DISCORD_GUILD_ID=

# Optional: only members with this role can add themselves.
DISCORD_REQUIRED_ROLE_ID=

# Optional: channel webhook (Channel settings → Integrations → Webhooks). The map picture
# is posted there once and the same message is edited whenever someone adds or moves a pin.
DISCORD_WEBHOOK_URL=

# Optional: token of a bot that is in the server. Used once an hour to remove pins of
# people who left the server (or lost the required role) and refresh names/avatars.
DISCORD_BOT_TOKEN=

# Optional
SITE_TITLE=Member Map
# Set to false to show the map only to logged-in members.
MAP_PUBLIC=true
# Where pins are stored (store.json). Must be persistent storage in production.
DATA_DIR=data
